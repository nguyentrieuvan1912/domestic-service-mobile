{
  "expo": {
    "name": "CleanMaster",
    "slug": "cleanmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cleanmaster",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.domesticservice.cleanmaster",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cho phép dùng micro để gọi cho khách hàng hoặc nhân viên trong đơn hàng.",
        "NSCameraUsageDescription": "Cho phép dùng camera khi bạn bật video trong cuộc gọi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.domesticservice.cleanmaster"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-notifications",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf5f80c7-fd42-40d6-b25a-2940a5343676"
      }
    },
    "owner": "quangvinh3010"
  }
}
